  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ShoulderCheckMain – scanning drill orchestrator</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input AssignableType_1 passer {\"hint\":\"Passer (centre-back), 12 o'clock\"}"
    - "// @input AssignableType_2 oppStriker {\"hint\":\"Opponent striker, 11 o'clock\"}"
    - "// @input AssignableType_3 presser {\"hint\":\"Presser (opponent), 5 o'clock\"}"
    - "// @input AssignableType_4 leftWinger {\"hint\":\"Left winger (teammate), 9 o'clock\"}"
    - "// @input AssignableType_5 rightWinger {\"hint\":\"Right winger (teammate), 3 o'clock\"}"
    - "// @input AssignableType_6 striker {\"hint\":\"Striker (teammate), 6 o'clock\"}"
    - "// @input AssignableType_7 oppMidfielder {\"hint\":\"Opponent midfielder, 7 o'clock\"}"
    - "// @input AssignableType_8 fullBack {\"hint\":\"Opponent full-back, 2 o'clock\"}"
    - '// @input AssignableType_9 levelStrip {"hint":"Level + scan strip UI module"}'
    - '// @input AssignableType_10 resultPanel {"hint":"Result panel UI module"}'
    - '// @input SceneObject pitchRoot {"hint":"Pitch root (floor level, centred on the receiver). Players, Ball and Feedback live under it."}'
    - '// @input SceneObject ball {"hint":"Ball SceneObject (child of the Pitch root); the ball visual is built under it."}'
    - '// @input SceneObject feedbackRoot {"hint":"Feedback SceneObject (child of the Pitch root); rings and lines are built under it."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - "// @ui {\"widget\":\"label\", \"label\":\"<span style=\\\"color: #60A5FA;\\\">Players' look</span>\"}"
    - "// @ui {\"widget\":\"group_start\", \"label\":\"Players' look\"}"
    - '// @input Asset.RenderMesh footballerMesh {"hint":"Footballer ready-stance mesh (Footballer_idle in Assets/Models/FootballerPoses.glb, built in Blender). Empty = old ghost figures."}'
    - '// @input Asset.RenderMesh[] runPoses {"hint":"Run cycle frames in order (Footballer_run_00..11). Empty = players glide."}'
    - '// @input Asset.RenderMesh[] kickPoses {"hint":"Kick frames: wind-up, strike, follow-through (Footballer_kick_0..2). Played by the passer."}'
    - '// @input bool showExtras = true {"hint":"Fill the pitch to 22 with background players (never pickable, keep their kits at the freeze)."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Pace and levels</span>"}'
    - '// @ui {"widget":"group_start", "label":"Pace and levels"}'
    - '// @input float basePassSec = 2 {"hint":"Ball travel time at level 1, s (brief: 1.5-2 s over 15 m).", "widget":"slider", "min":1, "max":3, "step":0.05}'
    - '// @input float speedupPerLevel = 0.1 {"hint":"Pass gets this fraction faster each level (0.1 = 10%).", "widget":"slider", "min":0, "max":0.3, "step":0.01}'
    - '// @input float minPassSec = 1 {"hint":"Fastest allowed pass, s (brief floor: 1.0 s).", "widget":"slider", "min":0.6, "max":2, "step":0.05}'
    - '// @input float correctToLevelUp = 2 {"hint":"Correct answers needed to move up a level.", "widget":"slider", "min":1, "max":5, "step":1}'
    - '// @input float wrongInRowToLevelDown = 2 {"hint":"Wrong answers in a row that drop you a level.", "widget":"slider", "min":1, "max":5, "step":1}'
    - '// @input float pickTimeEditorSec = 4 {"hint":"Pick timer in the Lens Studio preview, s.", "widget":"slider", "min":1, "max":10, "step":0.5}'
    - '// @input float pickTimeDeviceSec = 3 {"hint":"Pick timer on real glasses, s.", "widget":"slider", "min":1, "max":10, "step":0.5}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Scan rules</span>"}'
    - '// @ui {"widget":"group_start", "label":"Scan rules"}'
    - '// @input float scanMinYawDeg = 60 {"hint":"Head must turn at least this far from the ball for a scan, deg.", "widget":"slider", "min":30, "max":120, "step":1}'
    - '// @input float scanReturnDeg = 30 {"hint":"Head must come back within this angle of the ball (also re-arms the next scan), deg.", "widget":"slider", "min":5, "max":50, "step":1}'
    - "// @input float scanMaxHoldSec = 1.5 {\"hint\":\"Turns held longer than this (from crossing the min angle to coming back) don't count, s.\", \"widget\":\"slider\", \"min\":0.5, \"max\":4, \"step\":0.1}"
    - "// @input float viewHalfWidthDeg = 18.5 {\"hint\":\"Half-width of the central view window used for 'did you look at him', deg.\", \"widget\":\"slider\", \"min\":5, \"max\":40, \"step\":0.5}"
    - '// @input float viewHalfHeightDeg = 16 {"hint":"Half-height of the central view window, deg.", "widget":"slider", "min":5, "max":40, "step":0.5}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Round timing and movement</span>"}'
    - '// @ui {"widget":"group_start", "label":"Round timing and movement"}'
    - '// @input float betweenRoundsSec = 2 {"hint":"Pause between rounds with the level strip showing, s.", "widget":"slider", "min":0.5, "max":6, "step":0.1}'
    - '// @input float shapingSec = 0.6 {"hint":"Passer shapes to pass for this long before striking the ball, s (scan window opens here).", "widget":"slider", "min":0.2, "max":2, "step":0.05}'
    - '// @input float outcomeHoldSec = 1.2 {"hint":"Outcome feedback hold before the replay, s.", "widget":"slider", "min":0.3, "max":4, "step":0.1}'
    - '// @input float replaySec = 2.5 {"hint":"Replay length (free man ringed), s.", "widget":"slider", "min":1, "max":4, "step":0.1}'
    - '// @input float resultHoldSec = 1.5 {"hint":"Result stays up this long after the replay, s.", "widget":"slider", "min":0.5, "max":6, "step":0.1}'
    - '// @input float markGapCm = 150 {"hint":"How close a marker ends up to his man, goal-side, cm.", "widget":"slider", "min":50, "max":400, "step":10}'
    - '// @input float markerHeadStart = 0.5 {"hint":"Fraction of the way a marker already is at round start (0 = at home, 1 = already marking).", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float presserCloseCm = 160 {"hint":"When not marking, the presser closes to this distance behind you, cm.", "widget":"slider", "min":60, "max":300, "step":10}'
    - '// @input float freeManShowCm = 120 {"hint":"Free man steps wider to show for the ball, cm.", "widget":"slider", "min":0, "max":400, "step":10}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Colours</span>"}'
    - '// @ui {"widget":"group_start", "label":"Colours"}'
    - '// @input vec4 teammateColor = "{0.3,0.6,1,0.6}" {"hint":"Teammates (translucent blue).", "widget":"color"}'
    - '// @input vec4 opponentColor = "{1,0.3,0.25,0.6}" {"hint":"Opponents (translucent red).", "widget":"color"}'
    - '// @input vec4 silhouetteColor = "{0.72,0.72,0.75,0.6}" {"hint":"Identical grey silhouette at the freeze.", "widget":"color"}'
    - '// @input vec4 hoverColor = "{1,1,1,0.85}" {"hint":"Thin hover outline on the silhouette under the pointer.", "widget":"color"}'
    - '// @input vec4 foundColor = "{0.35,0.65,1,0.95}" {"hint":"Solid blue on the free man when found.", "widget":"color"}'
    - '// @input vec4 amberColor = "{1,0.72,0.15,0.9}" {"hint":"Amber flash for a marked teammate.", "widget":"color"}'
    - '// @input vec4 redColor = "{1,0.2,0.15,0.95}" {"hint":"Red flash for an opponent pick / marker highlight.", "widget":"color"}'
    - '// @input vec4 freeRingColor = "{0.3,1,0.4,0.9}" {"hint":"Green ring on the free man.", "widget":"color"}'
    - '// @input vec4 markerLineColor = "{1,0.45,0.35,0.85}" {"hint":"Line from a marker to the man he marks.", "widget":"color"}'
    - '// @input vec4 passLineColor = "{0.75,0.95,1,0.55}" {"hint":"Ghost pass line from you to the free man.", "widget":"color"}'
    - '// @input vec4 ballColor = "{0.95,0.95,0.95,1}" {"hint":"Ball colour.", "widget":"color"}'
    - '// @input float ringBaseRadiusCm = 45 {"hint":"Ground ring radius at 0 m, cm.", "widget":"slider", "min":20, "max":120, "step":1}'
    - '// @input float ringGrowthPerMeterCm = 2.2 {"hint":"Ground ring grows this much per metre of distance, cm (far players read on a glance).", "widget":"slider", "min":0, "max":6, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Audio</span>"}'
    - '// @ui {"widget":"group_start", "label":"Audio"}'
    - '// @input float passVolume = 0.8 {"hint":"Volume of the soft pass sound.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float resultVolume = 0.6 {"hint":"Volume of the result chimes.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Debug</span>"}'
    - '// @ui {"widget":"group_start", "label":"Debug"}'
    - '// @input bool runScanSelfTest = true {"hint":"Run the scan-counter self-test at start and print PASS/FAIL to the log."}'
    - '// @input bool logEvents = true {"hint":"Print round events (freeze, picks, scans, outcomes) to the log."}'
    - '// @input bool debugColliders {"hint":"Wireframe the pick colliders (takes effect on preview restart)."}'
    - '// @input bool autoStart = true {"hint":"Start rounds automatically. Off = wait for global.shoulderCheck.start()."}'
    - '// @ui {"widget":"group_end"}'
