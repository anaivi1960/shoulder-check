    - '// @input float stripes = 18 {"hint":"Number of mowing stripes between the goal lines.", "widget":"slider", "min":2, "max":30, "step":1}'
    - '// @input float lineWidthCm = 12 {"hint":"Painted line width, cm.", "widget":"slider", "min":4, "max":30, "step":1}'
    - '// @input vec4 grassLight = "{0.09,0.30,0.11,1}" {"hint":"Light mowing stripe. Additive display: keep it dim so players read on top.", "widget":"color"}'
    - '// @input vec4 grassDark = "{0.06,0.22,0.08,1}" {"hint":"Dark mowing stripe.", "widget":"color"}'
    - '// @input vec4 apronColor = "{0.05,0.18,0.07,1}" {"hint":"Run-off grass outside the lines.", "widget":"color"}'
    - '// @input vec4 lineColor = "{0.85,0.88,0.85,1}" {"hint":"Pitch line colour.", "widget":"color"}'
    - '// @input vec4 goalColor = "{0.95,0.95,0.95,1}" {"hint":"Goal frame colour.", "widget":"color"}'
    - '// @input vec4 netColor = "{0.9,0.9,0.9,0.18}" {"hint":"Goal net (translucent).", "widget":"color"}'
    - '// @input bool showPitch = true {"hint":"Show the pitch. Turn off on real glasses to train on your real pitch instead."}'
    - '// @ui {"widget":"group_end"}'
