  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ShoulderCheckPitch – full-size virtual pitch</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float pitchLengthCm = 10500 {"hint":"Pitch length goal line to goal line, cm (FIFA standard 105 m).", "widget":"slider", "min":6000, "max":12000, "step":50}'
    - '// @input float pitchWidthCm = 6800 {"hint":"Pitch width touchline to touchline, cm (FIFA standard 68 m).", "widget":"slider", "min":4000, "max":9000, "step":50}'
